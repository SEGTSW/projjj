{
  "name": "event-planner-architecture",
  "version": "1.0.0",
  "description": "Node.js + React event planning project with GoF patterns, in-memory repositories, tests, CI reports and Sonar configuration.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:ci": "node scripts/run-tests.mjs",
    "coverage": "node --experimental-test-coverage --test tests/*.test.js",
    "lint": "node scripts/static-check.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=20"
  }
}
